{
  "name": "tcc-identificacao-estruturas-vasculares",
  "version": "1.0.0",
  "description": "Este repositório contém um protótipo acadêmico de segmentação binária de estruturas vasculares em imagens de tecido tumoral. O fluxo converte anotações poligonais no formato COCO em máscaras, treina uma U-Net, registra a divisão dos dados no checkpoint e calcula Dice e IoU no subconjunto de validação.",
  "main": "index.ts",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test --env-file=.env --import tsx tests/*.test.ts",
    "test:inspect": "node --inspect --test --env-file=.env --import tsx tests/graph.inspect.test.ts",
    "neo4j:up": "docker compose up -d",
    "neo4j:down": "docker compose down",
    "neo4j:seed": "node --env-file=.env --import tsx src/services/seed.ts",
    "analyze:image": "node --env-file=.env --import tsx src/index.ts",
    "analyze:image:debug": "node --inspect --env-file=.env --import tsx src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmandaMNL/tcc-identificacao-estruturas-vasculares.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/AmandaMNL/tcc-identificacao-estruturas-vasculares/issues"
  },
  "homepage": "https://github.com/AmandaMNL/tcc-identificacao-estruturas-vasculares#readme",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "langchain": "^1.5.3",
    "neo4j-driver": "^6.2.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}